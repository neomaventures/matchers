{
  "name": "@neomaventures/matchers",
  "version": "0.1.0",
  "description": "Jest matchers for asserting an error's class and its properties in one assertion - toThrowMatching and toMatchError.",
  "type": "commonjs",
  "author": "Daniel Bruce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neomaventures/matchers.git"
  },
  "bugs": {
    "url": "https://github.com/neomaventures/matchers/issues"
  },
  "homepage": "https://github.com/neomaventures/matchers#readme",
  "keywords": [
    "jest",
    "matchers",
    "testing",
    "expect",
    "assertions",
    "error",
    "throw",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!**/*.json",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.lib.json",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:package": "pnpm build && publint && attw --pack",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "jest-matcher-utils": "^30.0.0"
  },
  "peerDependencies": {
    "@types/jest": ">=29",
    "jest": ">=29"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.12.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
